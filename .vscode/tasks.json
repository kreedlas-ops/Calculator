{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Собрать калькулятор",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Запустить калькулятор",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Run"
            ],
            "dependsOn": "Собрать калькулятор"
        },
        {
            "label": "Тесты движка",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tests\\run-tests.ps1"
            ],
            "group": "test",
            "problemMatcher": []
        }
    ]
}
